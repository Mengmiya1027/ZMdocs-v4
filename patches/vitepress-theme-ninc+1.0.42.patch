-    if (!addressRes.ok) {
-      throw new Error('Network response was not ok')
+
+    let ipData = await request(ipApiUrl)
+    let ip = ipData?.data?.ip || ipData?.ip || ''
+    let addressData = await request(locationApiTemplate.replace('${ip}', ip))
+    // 适配腾讯地图 IP 定位 API 返回格式
+    if (isQQMapApi(locationApiTemplate) && addressData?.result?.ad_info) {
+      const adInfo = addressData.result.ad_info
+      const location = addressData.result.location
+      userLocation.value = {
+        country: adInfo.nation,
+        province: adInfo.province,
+        city: adInfo.city,
+        longitude: location?.lng,
+        latitude: location?.lat,
+        ip: addressData.result.ip
